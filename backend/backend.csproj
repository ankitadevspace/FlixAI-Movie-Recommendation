<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>4d56b7fd-a2bc-44e5-bd0a-29c73ec675a7</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>

    <!-- ASP.NET CORE -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />

    <!-- AUTHENTICATION -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!--<PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.0.12" />-->

    <!-- ENTITY FRAMEWORK -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />

    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>
        runtime;
        build;
        native;
        contentfiles;
        analyzers;
        buildtransitive
      </IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />

    <!-- AI -->
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.9.0" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.9.0" />

    <!-- POSTGRESQL -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />

    <!-- PGVECTOR -->
    <PackageReference Include="Pgvector.EntityFrameworkCore" Version="0.3.0" />

    <!-- REDIS -->
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.12" />

    <!-- SWAGGER -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />

  </ItemGroup>

</Project>